{
  "name": "cardivo",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "Dynamic SVG card name for GitHub Magic Readme. Bun + Vercel serverless.",
  "license": "MIT",
  "main": "api/index.ts",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run --hot api/index.ts",
    "start": "bun run api/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts",
    "compare:prod": "bun run scripts/compare-prod.ts"
  },
  "dependencies": {
    "envalid": "^8.0.0",
    "hero-patterns": "^2.1.0",
    "ofetch": "^1.4.1",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.0.0",
    "@types/bun": "latest",
    "eslint": "^9.0.0",
    "eslint-compat-utils": "^0.5.0",
    "typescript": "^5.5.0"
  }
}
